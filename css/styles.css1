/* =========================================================================
   UJJWAL BHATIA â€” PORTFOLIO STYLES
   Dark / neon AI theme Â· glassmorphism Â· motion
   Tweak the variables below to re-skin the whole site in seconds.
   ========================================================================= */

:root {
  /* Core palette */
  --bg: #05060c;
  --bg-soft: #0a0c16;
  --surface: rgba(255, 255, 255, 0.035);
  --surface-2: rgba(255, 255, 255, 0.06);
  --border: rgba(255, 255, 255, 0.09);
  --text: #e8ecf5;
  --text-dim: #9aa3b8;
  --text-faint: #5e6781;

  /* Accents (the "AI" gradient) */
  --c1: #00e5ff;   /* cyan */
  --c2: #7c5cff;   /* violet */
  --accent-pink: #ff4ecd;
  --grad: linear-gradient(120deg, var(--c1), var(--c2) 55%, var(--accent-pink));
  --grad-soft: linear-gradient(120deg, rgba(0,229,255,.16), rgba(124,92,255,.16));
  --glow: 0 0 40px rgba(124, 92, 255, 0.35);

  --radius: 18px;
  --radius-sm: 12px;
  --maxw: 1180px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  font-family: "Space Grotesk", system-ui, sans-serif;
}

/* ----------------------------------------------------------------- RESET */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  background: var(--bg);
  color: var(--text);
  line-height: 1.65;
  overflow-x: hidden;
  font-size: 16px;
  cursor: default;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
ul { list-style: none; }
code {
  font-family: "JetBrains Mono", monospace;
  background: var(--surface-2);
  padding: 0.1em 0.45em;
  border-radius: 6px;
  font-size: 0.85em;
  color: var(--c1);
}

/* Background glow fields */
body::before, body::after {
  content: "";
  position: fixed;
  z-index: -3;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.45;
  pointer-events: none;
}
body::before { width: 50vw; height: 50vw; top: -15vw; right: -10vw; background: radial-gradient(circle, rgba(124,92,255,.5), transparent 70%); }
body::after  { width: 45vw; height: 45vw; bottom: -10vw; left: -12vw; background: radial-gradient(circle, rgba(0,229,255,.4), transparent 70%); }

#neural-canvas {
  position: fixed; inset: 0; z-index: -2;
  width: 100%; height: 100%;
  opacity: 0.9;
}

/* ----------------------------------------------------------- PROGRESS BAR */
#scroll-progress {
  position: fixed; top: 0; left: 0; height: 3px; width: 0%;
  background: var(--grad);
  z-index: 200;
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.7);
  transition: width 0.1s linear;
}

/* --------------------------------------------------------- CURSOR GLOW */
#cursor-glow {
  position: fixed; top: 0; left: 0;
  width: 380px; height: 380px;
  margin: -190px 0 0 -190px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124,92,255,.12), transparent 65%);
  pointer-events: none; z-index: -1;
  transition: opacity 0.3s;
}

/* ----------------------------------------------------------------- NAV */
#navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem clamp(1rem, 4vw, 3rem);
  transition: background 0.4s, padding 0.4s, border-color 0.4s;
  border-bottom: 1px solid transparent;
}
#navbar.scrolled {
  background: rgba(5, 6, 12, 0.72);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
  padding-top: 0.7rem; padding-bottom: 0.7rem;
}
.nav-logo .logo-mark {
  font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.25rem;
  background: var(--grad); -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; letter-spacing: 1px;
  border: 1px solid var(--border); padding: 0.35rem 0.6rem; border-radius: 10px;
  transition: transform 0.3s var(--ease), box-shadow 0.3s;
  display: inline-block;
}
.nav-logo:hover .logo-mark { transform: translateY(-2px); box-shadow: var(--glow); }
.nav-links { display: flex; gap: 1.6rem; }
.nav-links a {
  font-size: 0.92rem; color: var(--text-dim); position: relative;
  transition: color 0.25s; font-weight: 500;
}
.nav-links a::after {
  content: ""; position: absolute; left: 0; bottom: -5px; height: 2px; width: 0;
  background: var(--grad); transition: width 0.3s var(--ease);
}
.nav-links a:hover { color: var(--text); }
.nav-links a:hover::after { width: 100%; }
.nav-cta {
  font-size: 0.88rem; font-weight: 600; padding: 0.55rem 1.1rem;
  border-radius: 10px; border: 1px solid var(--border);
  background: var(--surface); transition: all 0.3s var(--ease);
}
.nav-cta:hover { border-color: transparent; background: var(--grad); color: #05060c; box-shadow: var(--glow); }
#nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
#nav-toggle span { width: 26px; height: 2px; background: var(--text); transition: 0.3s; }

/* ----------------------------------------------------------- SECTIONS */
.section {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: clamp(4rem, 9vw, 7rem) clamp(1.2rem, 5vw, 2rem);
}
.section-head { margin-bottom: 3rem; }
.section-head.center { text-align: center; }
.section-kicker {
  font-family: "JetBrains Mono", monospace; font-size: 0.82rem; letter-spacing: 2px;
  text-transform: uppercase; color: var(--c1); display: inline-block; margin-bottom: 0.7rem;
}
.section-title {
  font-family: "Sora", sans-serif; font-weight: 800;
  font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -1px;
}
.section-desc { color: var(--text-dim); margin-top: 0.9rem; max-width: 620px; }
.section-head.center .section-desc { margin-inline: auto; }
.gradient-text {
  background: var(--grad); -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ----------------------------------------------------------- GLASS CARD */
.glass {
  background: var(--surface);
  border: 1px solid var(--border);
  backdrop-filter: blur(14px);
  border-radius: var(--radius);
}

/* ----------------------------------------------------------- BUTTONS */
.btn {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-weight: 600; font-size: 0.95rem; padding: 0.8rem 1.5rem;
  border-radius: 12px; border: 1px solid var(--border);
  cursor: pointer; transition: all 0.3s var(--ease); position: relative; overflow: hidden;
}
.btn-lg { padding: 1rem 2rem; font-size: 1.05rem; }
.btn-primary { background: var(--grad); color: #05060c; border-color: transparent; }
.btn-primary:hover { transform: translateY(-3px); box-shadow: var(--glow); }
.btn-ghost { background: var(--surface); color: var(--text); }
.btn-ghost:hover { background: var(--surface-2); border-color: var(--c1); transform: translateY(-3px); }

/* =============================================================== HERO */
.hero {
  min-height: 100vh; display: flex; flex-direction: column;
  justify-content: center; position: relative; padding-top: 6rem;
}
.hero-inner { max-width: 860px; }
.hero-status {
  display: inline-flex; align-items: center; gap: 0.6rem;
  font-family: "JetBrains Mono", monospace; font-size: 0.85rem; color: var(--text-dim);
  border: 1px solid var(--border); border-radius: 100px; padding: 0.4rem 1rem;
  background: var(--surface); margin-bottom: 1.6rem;
}
.pulse-dot {
  width: 9px; height: 9px; border-radius: 50%; background: #2bd576; position: relative;
}
.pulse-dot.small { width: 7px; height: 7px; display: inline-block; margin-right: 5px; }
.pulse-dot::after {
  content: ""; position: absolute; inset: 0; border-radius: 50%; background: #2bd576;
  animation: ping 1.8s var(--ease) infinite;
}
@keyframes ping { 0% { transform: scale(1); opacity: 0.7; } 80%,100% { transform: scale(3); opacity: 0; } }

.hero-title { font-family: "Sora", sans-serif; line-height: 1; margin-bottom: 0.6rem; }
.hero-greet { display: block; font-size: clamp(1.1rem, 3vw, 1.6rem); color: var(--text-dim); font-weight: 500; margin-bottom: 0.4rem; }
.hero-name {
  display: block; font-weight: 800; letter-spacing: -2px;
  font-size: clamp(2.8rem, 10vw, 6rem);
  background: linear-gradient(120deg, #fff 20%, var(--c1) 55%, var(--c2));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.hero-sub {
  font-family: "Sora", sans-serif; font-weight: 700;
  font-size: clamp(1.4rem, 4.5vw, 2.6rem); margin: 0.8rem 0 1.4rem; letter-spacing: -0.5px;
}
.caret { color: var(--c1); animation: blink 1s steps(2) infinite; font-weight: 400; }
@keyframes blink { 50% { opacity: 0; } }
.hero-tagline { color: var(--text-dim); font-size: clamp(1rem, 2.2vw, 1.18rem); max-width: 640px; margin-bottom: 2rem; }
.hero-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 2rem; }
.hero-socials { display: flex; gap: 0.7rem; flex-wrap: wrap; }
.social-btn {
  width: 44px; height: 44px; display: grid; place-items: center;
  border: 1px solid var(--border); border-radius: 12px; background: var(--surface);
  transition: all 0.3s var(--ease); color: var(--text-dim);
}
.social-btn:hover { color: var(--text); border-color: var(--c1); transform: translateY(-3px); box-shadow: var(--glow); }
.social-btn svg { width: 20px; height: 20px; }

.scroll-hint {
  position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
  width: 26px; height: 42px; border: 2px solid var(--border); border-radius: 14px;
}
.scroll-hint span {
  position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
  width: 4px; height: 8px; background: var(--c1); border-radius: 4px;
  animation: scrolldot 1.8s infinite;
}
@keyframes scrolldot { 0% { opacity: 0; top: 8px; } 40% { opacity: 1; } 80%,100% { opacity: 0; top: 24px; } }

/* =============================================================== STATS */
.stats-section { padding-top: 0; padding-bottom: 2rem; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.2rem; }
.stat-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 1.6rem; text-align: center; transition: all 0.4s var(--ease);
  position: relative; overflow: hidden;
}
.stat-card:hover { transform: translateY(-5px); border-color: rgba(124,92,255,.5); }
.stat-card .stat-icon { font-size: 1.4rem; margin-bottom: 0.4rem; }
.stat-value { font-family: "Sora", sans-serif; font-weight: 800; font-size: 2.2rem; line-height: 1; }
.stat-label { color: var(--text-dim); font-size: 0.9rem; margin-top: 0.4rem; }

/* =============================================================== ABOUT */
.about-wrap { display: grid; grid-template-columns: 1.6fr 1fr; gap: 2.5rem; align-items: start; }
.about-text p { color: var(--text-dim); margin-bottom: 1.1rem; font-size: 1.05rem; }
.about-text p:first-child { color: var(--text); font-size: 1.15rem; }
.about-card { padding: 2rem; text-align: center; position: sticky; top: 6rem; }
.about-monogram {
  width: 90px; height: 90px; margin: 0 auto 1.4rem; border-radius: 22px;
  display: grid; place-items: center; font-family: "Sora", sans-serif; font-weight: 800;
  font-size: 2rem; color: #05060c; background: var(--grad); box-shadow: var(--glow);
}
.about-card img.about-monogram { object-fit: cover; }
.about-facts { text-align: left; display: grid; gap: 0.9rem; }
.about-facts li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--text-dim); font-size: 0.95rem; }
.about-facts li span:first-child { flex-shrink: 0; }

/* =============================================================== SKILLS */
.skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
.skill-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 1.8rem; transition: all 0.4s var(--ease);
}
.skill-card:hover { border-color: rgba(0,229,255,.4); transform: translateY(-4px); }
.skill-card h3 {
  font-family: "Sora", sans-serif; font-size: 1.15rem; margin-bottom: 1.3rem;
  display: flex; align-items: center; gap: 0.6rem;
}
.skill-card h3 .sk-icon {
  width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center;
  background: var(--grad-soft); font-size: 1rem;
}
.skill-item { margin-bottom: 1rem; }
.skill-item:last-child { margin-bottom: 0; }
.skill-item .sk-top { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem; }
.skill-item .sk-top span:last-child { color: var(--text-faint); font-family: "JetBrains Mono", monospace; font-size: 0.8rem; }
.sk-bar { height: 7px; background: var(--surface-2); border-radius: 100px; overflow: hidden; }
.sk-fill { height: 100%; width: 0; background: var(--grad); border-radius: 100px; transition: width 1.2s var(--ease); }

/* ============================================================ TIMELINE */
.timeline { position: relative; padding-left: 2rem; }
.timeline::before {
  content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px;
  background: linear-gradient(180deg, var(--c1), var(--c2), transparent);
}
.tl-item { position: relative; margin-bottom: 2.4rem; }
.tl-item::before {
  content: ""; position: absolute; left: -2rem; top: 6px; width: 16px; height: 16px;
  border-radius: 50%; background: var(--bg); border: 3px solid var(--c1);
  box-shadow: 0 0 14px rgba(0,229,255,.6); transform: translateX(0);
}
.tl-item.current::before { border-color: var(--accent-pink); box-shadow: 0 0 14px rgba(255,78,205,.7); }
.tl-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 1.6rem 1.8rem; transition: all 0.4s var(--ease);
}
.tl-card:hover { transform: translateX(6px); border-color: rgba(124,92,255,.45); }
.tl-head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; }
.tl-role { font-family: "Sora", sans-serif; font-weight: 700; font-size: 1.2rem; }
.tl-org { color: var(--c1); font-weight: 600; }
.tl-period { font-family: "JetBrains Mono", monospace; font-size: 0.8rem; color: var(--text-faint); white-space: nowrap; }
.tl-loc { color: var(--text-faint); font-size: 0.85rem; margin: 0.2rem 0 0.9rem; }
.tl-bullets { display: grid; gap: 0.55rem; margin-bottom: 1rem; }
.tl-bullets li { color: var(--text-dim); font-size: 0.95rem; padding-left: 1.2rem; position: relative; }
.tl-bullets li::before { content: "â–¹"; position: absolute; left: 0; color: var(--c1); }
.tag-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.tag {
  font-family: "JetBrains Mono", monospace; font-size: 0.72rem; padding: 0.25rem 0.6rem;
  border-radius: 7px; background: var(--grad-soft); border: 1px solid var(--border); color: var(--text-dim);
}
.badge-now {
  font-size: 0.68rem; font-family: "JetBrains Mono", monospace; color: var(--accent-pink);
  border: 1px solid rgba(255,78,205,.4); border-radius: 6px; padding: 0.1rem 0.45rem; margin-left: 0.5rem;
}

/* ============================================================ PROJECTS */
.projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
.project-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 1.8rem; transition: all 0.4s var(--ease); position: relative; overflow: hidden;
  display: flex; flex-direction: column;
}
.project-card::before {
  content: ""; position: absolute; inset: 0; background: var(--grad-soft); opacity: 0;
  transition: opacity 0.4s; z-index: 0;
}
.project-card:hover { transform: translateY(-6px); border-color: rgba(0,229,255,.5); }
.project-card:hover::before { opacity: 1; }
.project-card > * { position: relative; z-index: 1; }
.proj-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
.proj-icon { font-size: 1.6rem; }
.proj-highlight {
  font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: var(--c1);
  border: 1px solid var(--border); border-radius: 6px; padding: 0.2rem 0.55rem;
}
.project-card h3 { font-family: "Sora", sans-serif; font-size: 1.25rem; margin-bottom: 0.7rem; }
.project-card p { color: var(--text-dim); font-size: 0.95rem; margin-bottom: 1.2rem; flex-grow: 1; }
.proj-links { display: flex; gap: 0.7rem; margin-bottom: 1rem; }
.proj-link {
  font-size: 0.85rem; font-weight: 600; color: var(--c1);
  display: inline-flex; align-items: center; gap: 0.3rem;
}
.proj-link:hover { text-decoration: underline; }

/* ========================================================= ACHIEVEMENTS */
.achievements-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
.ach-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 1.4rem; display: flex; gap: 1rem; transition: all 0.35s var(--ease);
}
.ach-card:hover { transform: translateY(-4px); border-color: rgba(124,92,255,.5); background: var(--surface-2); }
.ach-icon {
  width: 44px; height: 44px; flex-shrink: 0; border-radius: 12px; display: grid; place-items: center;
  font-size: 1.3rem; background: var(--grad-soft); border: 1px solid var(--border);
}
.ach-card h4 { font-size: 1rem; font-family: "Sora", sans-serif; margin-bottom: 0.2rem; }
.ach-card p { color: var(--text-dim); font-size: 0.85rem; }
.ach-year { color: var(--text-faint); font-family: "JetBrains Mono", monospace; font-size: 0.75rem; }

/* =========================================================== EDUCATION */
.education-list { display: grid; gap: 1.2rem; }
.edu-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 1.6rem 1.8rem; display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
  transition: all 0.35s var(--ease);
}
.edu-card:hover { border-color: rgba(0,229,255,.4); transform: translateX(6px); }
.edu-card h3 { font-family: "Sora", sans-serif; font-size: 1.2rem; }
.edu-degree { color: var(--c1); font-weight: 600; margin: 0.2rem 0; }
.edu-card p { color: var(--text-dim); font-size: 0.92rem; }
.edu-period { font-family: "JetBrains Mono", monospace; color: var(--text-faint); font-size: 0.85rem; white-space: nowrap; }

/* ============================================================ TERMINAL */
.terminal { overflow: hidden; max-width: 820px; font-family: "JetBrains Mono", monospace; }
.terminal-bar {
  display: flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1rem;
  background: rgba(255,255,255,0.04); border-bottom: 1px solid var(--border);
}
.terminal-bar .dot { width: 12px; height: 12px; border-radius: 50%; }
.dot.red { background: #ff5f57; } .dot.yellow { background: #febc2e; } .dot.green { background: #28c840; }
.terminal-title { margin-left: 0.6rem; color: var(--text-faint); font-size: 0.82rem; }
.terminal-body { padding: 1.2rem 1.3rem; min-height: 220px; max-height: 360px; overflow-y: auto; font-size: 0.88rem; }
.terminal-line { margin-bottom: 0.4rem; white-space: pre-wrap; word-break: break-word; }
.terminal-line .prompt { color: var(--c1); margin-right: 0.5rem; }
.terminal-line.output { color: var(--text-dim); padding-left: 0.2rem; }
.terminal-line.output .hl { color: var(--accent-pink); }
.terminal-line.output .ok { color: #2bd576; }
.terminal-input-line {
  display: flex; align-items: center; padding: 0.8rem 1.3rem; border-top: 1px solid var(--border);
  background: rgba(255,255,255,0.02);
}
.terminal-input-line .prompt { color: var(--c1); margin-right: 0.5rem; font-size: 0.88rem; }
#terminal-input {
  flex: 1; background: none; border: 0; outline: none; color: var(--text);
  font-family: "JetBrains Mono", monospace; font-size: 0.88rem; caret-color: var(--c1);
}

/* ============================================================= CONTACT */
.contact-actions { display: flex; flex-direction: column; align-items: center; gap: 1.8rem; }
.contact-socials { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; }

/* ============================================================== FOOTER */
footer {
  text-align: center; padding: 3rem 1rem; border-top: 1px solid var(--border);
  color: var(--text-dim); font-size: 0.9rem;
}
.footer-note { color: var(--text-faint); font-size: 0.82rem; margin-top: 0.3rem; }

/* ====================================================== CHAT ASSISTANT */
#chat-fab {
  position: fixed; bottom: 1.6rem; right: 1.6rem; z-index: 150;
  display: inline-flex; align-items: center; gap: 0.6rem;
  padding: 0.85rem 1.3rem; border: 0; border-radius: 100px; cursor: pointer;
  background: var(--grad); color: #05060c; font-weight: 700; font-size: 0.95rem;
  box-shadow: var(--glow); transition: transform 0.3s var(--ease);
  font-family: "Space Grotesk", sans-serif;
}
#chat-fab:hover { transform: translateY(-3px) scale(1.03); }
#chat-fab .fab-icon { font-size: 1.15rem; animation: spin 6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

#chat-panel {
  position: fixed; bottom: 1.6rem; right: 1.6rem; z-index: 160;
  width: min(390px, calc(100vw - 2rem)); height: min(560px, calc(100vh - 3rem));
  display: flex; flex-direction: column; overflow: hidden;
  transform: translateY(20px) scale(0.96); opacity: 0; pointer-events: none;
  transition: transform 0.35s var(--ease), opacity 0.35s;
}
#chat-panel.open { transform: translateY(0) scale(1); opacity: 1; pointer-events: auto; }
.chat-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 1.2rem; border-bottom: 1px solid var(--border); background: rgba(255,255,255,0.03);
}
.chat-id { display: flex; align-items: center; gap: 0.7rem; }
.chat-avatar {
  width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center;
  background: var(--grad); color: #05060c; font-size: 1.1rem;
}
.chat-id strong { font-family: "Sora", sans-serif; font-size: 0.95rem; display: block; }
.chat-id small { color: var(--text-dim); font-size: 0.76rem; }
#chat-close { background: none; border: 0; color: var(--text-dim); font-size: 1rem; cursor: pointer; padding: 6px; }
#chat-close:hover { color: var(--text); }
.chat-messages { flex: 1; overflow-y: auto; padding: 1.1rem; display: flex; flex-direction: column; gap: 0.8rem; }
.msg { max-width: 85%; padding: 0.7rem 1rem; border-radius: 14px; font-size: 0.9rem; line-height: 1.5; }
.msg.bot { background: var(--surface-2); border: 1px solid var(--border); border-bottom-left-radius: 4px; align-self: flex-start; }
.msg.user { background: var(--grad); color: #05060c; border-bottom-right-radius: 4px; align-self: flex-end; font-weight: 500; }
.msg.typing { display: flex; gap: 4px; }
.msg.typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--text-dim); animation: typing 1.2s infinite; }
.msg.typing span:nth-child(2) { animation-delay: 0.2s; } .msg.typing span:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing { 0%,60%,100% { opacity: 0.3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-4px); } }
.chat-suggestions { display: flex; gap: 0.5rem; padding: 0 1.1rem 0.6rem; flex-wrap: wrap; }
.chat-chip {
  font-size: 0.78rem; padding: 0.4rem 0.8rem; border-radius: 100px; cursor: pointer;
  border: 1px solid var(--border); background: var(--surface); color: var(--text-dim);
  transition: all 0.25s; font-family: inherit;
}
.chat-chip:hover { border-color: var(--c1); color: var(--text); }
.chat-input { display: flex; gap: 0.5rem; padding: 0.9rem 1.1rem; border-top: 1px solid var(--border); }
.chat-input input {
  flex: 1; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px;
  padding: 0.65rem 0.9rem; color: var(--text); font-family: inherit; font-size: 0.9rem; outline: none;
}
.chat-input input:focus { border-color: var(--c1); }
.chat-input button {
  width: 42px; border: 0; border-radius: 10px; background: var(--grad); color: #05060c;
  font-size: 1.1rem; cursor: pointer; transition: transform 0.2s;
}
.chat-input button:hover { transform: scale(1.06); }

/* ====================================================== SCROLL REVEAL */
[data-reveal] { opacity: 0; transform: translateY(30px); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
[data-reveal].visible { opacity: 1; transform: none; }

/* ============================================================ RESPONSIVE */
@media (max-width: 860px) {
  .about-wrap { grid-template-columns: 1fr; }
  .about-card { position: static; }
  .nav-links, .nav-cta { display: none; }
  .nav-links.open {
    display: flex; flex-direction: column; position: absolute; top: 100%; left: 0; right: 0;
    background: rgba(5,6,12,0.97); backdrop-filter: blur(16px); padding: 1.5rem 2rem;
    gap: 1.2rem; border-bottom: 1px solid var(--border);
  }
  #nav-toggle { display: flex; }
  #nav-toggle.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #nav-toggle.active span:nth-child(2) { opacity: 0; }
  #nav-toggle.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
}
@media (max-width: 520px) {
  #chat-fab .fab-label { display: none; }
  #chat-fab { padding: 0.9rem; }
  .edu-card { flex-direction: column; }
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  html { scroll-behavior: auto; }
}
